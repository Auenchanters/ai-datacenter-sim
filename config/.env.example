# =============================================================
# ai-datacenter-sim  |  Environment Configuration
# =============================================================
# Copy this file to .env in the project root directory:
#   cp config/.env.example .env
#
# NEVER commit your actual .env file to git.
# The .gitignore already excludes .env by default.
# =============================================================


# -------------------------------------------------------------
# OPENROUTER API KEY  (single key — used by all agents)
# All three competing agents share this one key.
# Get a free key at: https://openrouter.ai/keys
# -------------------------------------------------------------

OPENROUTER_API_KEY=your_openrouter_key_here


# -------------------------------------------------------------
# OPTIONAL: Per-model key overrides
# If set, the agent for that model uses this key instead of
# OPENROUTER_API_KEY above. Leave blank or commented out to
# just use the single key.
# -------------------------------------------------------------

# OPENROUTER_API_KEY_NEMOTRON=your_openrouter_key_here
# OPENROUTER_API_KEY_MISTRAL=your_openrouter_key_here
# OPENROUTER_API_KEY_GEMINI=your_openrouter_key_here


# Optional: used for non-OpenRouter providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=


# -------------------------------------------------------------
# SIMULATION SETTINGS
# -------------------------------------------------------------

GRID_WIDTH=20
GRID_HEIGHT=20
STARTING_BUDGET=500000
ELECTRICITY_COST_PER_KWH=0.12
SIMULATION_TICKS=100


# -------------------------------------------------------------
# OPENROUTER METADATA (optional, shown in your OpenRouter dashboard)
# -------------------------------------------------------------

OPENROUTER_APP_NAME=ai-datacenter-sim
OPENROUTER_SITE_URL=http://localhost:8000
