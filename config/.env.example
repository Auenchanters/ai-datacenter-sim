GOOGLE_API_KEY=your_google_api_key_here

# Simulation settings
GRID_WIDTH=20
GRID_HEIGHT=20
STARTING_BUDGET=500000
ELECTRICITY_COST_PER_KWH=0.12
SIMULATION_TICKS=100
