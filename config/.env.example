# =============================================================
# ai-datacenter-sim  |  Environment Configuration
# =============================================================
# Copy this file to .env in the project root directory:
#   cp config/.env.example .env
#
# NEVER commit your actual .env file to git.
# The .gitignore already excludes .env by default.
# =============================================================


# -------------------------------------------------------------
# OPENROUTER API KEYS
# Each competing model uses its own key.
# Get free keys at: https://openrouter.ai/keys
# -------------------------------------------------------------

# nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEY_NEMOTRON=your_openrouter_key_here

# minimax/minimax-m2.5:free
OPENROUTER_API_KEY_MINIMAX=your_openrouter_key_here

# qwen/qwen3-coder:free
OPENROUTER_API_KEY_QWEN=your_openrouter_key_here

# Optional: single fallback key used if a model-specific key is missing
# OPENROUTER_API_KEY=your_fallback_key_here

# Optional: used for non-OpenRouter providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=


# -------------------------------------------------------------
# SIMULATION SETTINGS
# -------------------------------------------------------------

GRID_WIDTH=20
GRID_HEIGHT=20
STARTING_BUDGET=500000
ELECTRICITY_COST_PER_KWH=0.12
SIMULATION_TICKS=100


# -------------------------------------------------------------
# OPENROUTER METADATA (optional, shown in your OpenRouter dashboard)
# -------------------------------------------------------------

OPENROUTER_APP_NAME=ai-datacenter-sim
OPENROUTER_SITE_URL=http://localhost:8000
